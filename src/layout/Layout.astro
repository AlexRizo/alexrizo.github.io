---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import "@/styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta name="title" content="Mi Portafolio" />
    <meta
      name="description"
      content="Mi nombre es David Alejandro Ayala Rizo, un desarrollador Full-Stack enfocado en soluciones innovadoras y escalables utilizando el ecosistema de TypeScript."
    />
    <meta
      name="keywords"
      content="Alex Rizo, Portafolio, Desarrollador, Full-Stack, TypeScript, JavaScript, React, Node.js, Express, MongoDB, PostgreSQL, Git, GitHub, HTML, CSS, Tailwind CSS, Bootstrap, Figma, Adobe XD, Sketch, Jira, Trello, Asana, Slack, Microsoft Teams, Zoom, Google Meet, Web, Mobile, Desktop, Responsive, Adaptive, Progressive, Single Page Application, Multi Page Application, Server Side Rendering, Client Side Rendering, Static Site Generation, Jamstack, PWA, SPA, MPA, SSR, CSR, SSG, Jamstack, PWA"
    />
    <meta name="author" content="Alex Rizo" />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Animaciones de entrada: se activan antes del primer pintado para que
      // el contenido no parpadee. Sin JS o sin IntersectionObserver todo se ve
      // normal, y si el observer no arranca en 2.5 s se muestra todo igual.
      (() => {
        if (!("IntersectionObserver" in window)) return;
        const root = document.documentElement;
        const enable = () => {
          root.classList.add("reveal-ready");
          setTimeout(() => {
            if (!root.dataset.revealActive) root.classList.remove("reveal-ready");
          }, 2500);
        };
        enable();
        document.addEventListener("astro:after-swap", enable);
      })();
    </script>
    <ClientRouter />
    <title>Alex Rizo Dev</title>
  </head>
  <body transition:animate="slide">
    <Header />
    <main
      class="container mx-auto relative flex flex-col lg:flex-row justify-center gap-20 px-4 lg:px-0"
    >
      <ProfileCard />
      <div role="main" class="w-auto lg:w-xl xl:w-2xl space-y-30">
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      const TARGETS = "[data-reveal], [data-reveal-group] > *";

      // Lo que entra a la vista en el mismo momento aparece escalonado
      const setupReveal = () => {
        const root = document.documentElement;
        root.dataset.revealActive = "true";

        const observer = new IntersectionObserver(
          (entries) => {
            let order = 0;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.style.setProperty("--reveal-delay", String(order++));
              el.classList.add("is-revealed");
              observer.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );

        document.querySelectorAll(TARGETS).forEach((el) => observer.observe(el));
      };

      document.addEventListener("astro:page-load", setupReveal);
    </script>
  </body>
</html>
