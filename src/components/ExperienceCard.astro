---
import { MoveUpRight } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  date: string;
  url?: string;
}

const { title, description, date, url } = Astro.props;

const Wrapper = url ? "a" : "div";
const linkProps = url
  ? { href: url, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<div
  role="group"
  class="group hover:bg-white/3 transition-colors duration-300 rounded-xl p-5 border border-neutral-800 lg:border-0"
>
  <Wrapper {...linkProps} class="flex flex-row gap-5">
    <article class="max-w-lg">
      <h1 class="text-white text-xl lg:text-2xl xl:text-3xl font-semibold">{title}</h1>
      <p class="mt-1 text-sm lg:text-base">{description}</p>
      <p class="mt-2 text-xs lg:text-sm">- {date}</p>
    </article>
    {
      url && (
        <MoveUpRight
          size={20}
          class="text-orange-500 ml-auto mt-2 mr-2 group-hover:transform-[translate(10px,-10px)] transition-transform duration-300 ease-in-out min-w-5"
        />
      )
    }
  </Wrapper>
</div>
