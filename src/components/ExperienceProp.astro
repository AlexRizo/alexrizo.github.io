---
interface Props {
  years: number;
  description: string;
}

const { years, description } = Astro.props;
---

<div role="contentinfo">
  <h1 class="text-white font-semibold text-5xl lg:text-6xl xl:text-7xl">+{years}</h1>
  <p class="max-w-30 leading-tight uppercase text-center lg:text-left">{description}</p>
</div>
