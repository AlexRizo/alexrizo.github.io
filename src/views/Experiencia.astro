---
import ExperienceCard from "@/components/ExperienceCard.astro";
import Title from "@/components/Title.astro";
---

<section id="experiencia">
  <Title><span>+5 años de</span> <br />experiencia</Title>
  <div class="space-y-4 lg:space-y-0">
    <ExperienceCard
      title="Rizcode | Fundador y Desarrollador Full-Stack"
      description="Fundé mi propio estudio para trabajar directamente con clientes en sitios web, tiendas en línea, APIs y aplicaciones a la medida. Me encargo de todo el proceso: entender la idea, proponer la solución, desarrollarla y acompañar el lanzamiento."
      date="2026 - Actualidad"
      url="https://rizcode.dev"
    />
    <ExperienceCard
      title="Alowee | Desarrollador Full-Stack"
      description="Desarrollo sitios y aplicaciones web para los clientes de la agencia, incluido el sitio de la propia Alowee. También he apoyado en fotografía, edición con Lightroom Classic y soporte informático."
      date="2021 - Actualidad"
      url="https://alowee.com/"
    />
  </div>
</section>
