---
import ProyectCard from "@/components/ProyectCard.astro";
import Title from "@/components/Title.astro";
---

<section id="proyectos">
  <Title><span>Proyectos</span> <br />recientes</Title>
  <div role="grid" class="grid grid-cols-1 gap-4 mt-5">
    <ProyectCard
      title="Alowee Interactive"
      description="Estudio interactivo que ofrece todo tipo de servicios digitales. (actualmente en remodelación)"
      image="/imagenes/proyectos/alowee.webp"
      url="https://alowee-v3.netlify.app"
    />
    <ProyectCard
      title="Not Alias_"
      description="Sitio web para una agencia de marketing digital que rompe con lo convencional. (actualmente en remodelación)"
      image="/imagenes/proyectos/notalias_.webp"
      url="https://notalias.com"
    />
    <ProyectCard
      title="Ezlabon.mx"
      description="Plataforma web para optimizar la operación logística de una transportista de carga federal."
      image="/imagenes/proyectos/ezlabon.webp"
      url="https://ezlabon.mx"
    />
    <ProyectCard
      title="Printa"
      description="Sitio web para una imprenta digital, pensado para simplificar cotizaciones y pedidos online"
      image="/imagenes/proyectos/printa.webp"
      url="https://printafast.com"
    />
    <ProyectCard
      title="Eric Beas - Urólogo"
      description="Landing page para un urólogo, diseñado para transmitir confianza y profesionalismo."
      image="/imagenes/proyectos/eric-beas-urologo.webp"
      url="https://eric-beas.urologo-en-colima.com"
    />
    <ProyectCard
      title="Meteoro"
      description="Sitio web para un venture studio, diseñado para transmitir innovación y escalabilidad."
      image="/imagenes/proyectos/meteoro.webp"
      url="https://meteoroventures.com"
    />
    <ProyectCard
      title="Camina Conmigo"
      description="Sitio web para una organización religiosa, enfocado en la evangelización."
      image="/imagenes/proyectos/camina-conmigo.webp"
      url="https://caminaconmigo.org"
    />
  </div>
</section>
