---
import Skills from "@/components/Skills.astro";
import ExperienceProp from "@/components/ExperienceProp.astro";
import { CodeXml, Server } from "@lucide/astro";
---

<section class="flex flex-col" id="inicio">
  <article data-reveal-group>
    <h1
      class="text-neutral-700 font-bold text-5xl text-center lg:text-left lg:text-8xl xl:text-[108px] leading-none uppercase"
    >
      <span class="text-white">Full-Stack</span><br /> Developer
    </h1>
    <p class="text-neutral-400 text-lg text-center lg:text-left lg:max-w-[480px] my-4">
      Llevo más de 5 años construyendo para la web con JavaScript y
      TypeScript. Me gusta llevar ideas del prototipo a producción: sitios
      rápidos con Astro, aplicaciones con React y APIs con NestJS.
    </p>
  </article>
  <aside data-reveal-group class="flex flex-row justify-center lg:justify-normal gap-5 sm:gap-10 mt-12">
    <ExperienceProp years={5} description="Años de experiencia" />
    <ExperienceProp years={10} description="Proyectos completados" />
    <ExperienceProp years={10} description="Clientes satisfechos" />
  </aside>
  <div data-reveal-group class="flex flex-col lg:flex-row gap-8 mt-16">
    <Skills
      icon={CodeXml}
      description="Desarrollador Frontend en React"
      href="/tecnologias"
      color="blue"
      decorators={["react", "tanstack"]}
    />
    <Skills
      icon={Server}
      description="Desarrollador Backend en NodeJS"
      href="/tecnologias"
      color="green"
      decorators={["nodedotjs", "nestjs"]}
      size="large"
    />
  </div>
</section>
